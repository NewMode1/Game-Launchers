{
  "name": "exe-launcher",
  "productName": "Program Launcher",
  "version": "1.2.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --x64",
    "build:x32": "electron-builder --win portable --ia32",
    "build:all": "electron-builder --win portable --x64 --ia32",
    "build:installer": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "local.exelauncher",
    "executableName": "ProgramLauncher",
    "directories": {
      "output": "versions"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!versions/**",
      "!README.md"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "ProgramLauncher_${version}-${arch}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "ProgramLauncher_${version}-${arch}-setup.exe"
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ]
  }
}